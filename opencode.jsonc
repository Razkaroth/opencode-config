{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@mohak34/opencode-notifier@0.2.8",
    "@plannotator/opencode@0.21.1",
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": ["playwright-mcp"],
      "enabled": true,
    },
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-terra",
    },
    "build": {
      "model": "openai/gpt-5.6-terra",
    },
    "explore": {
      "model": "opencode/deepseek-v4-flash-free",
      "prompt": "{file:/home/raz/.config/opencode/prompt_overrides/explorer.md}",
    },
  },
  "instructions": [
    "/home/raz/.config/opencode/instructions/explorer.md",
    "/home/raz/.config/opencode/instructions/caveman.md",
    "/home/raz/.config/opencode/instructions/USER_INTERACTION.md",
  ],
}
