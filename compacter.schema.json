{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.ai/local/compacter.schema.json",
  "title": "OpenCode Auto Compacter Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "excludedModels": {
      "type": "array",
      "description": "Models that should never trigger automatic compaction. Values use provider/model format from `opencode models`.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "opencode/big-pickle",
          "opencode/gpt-5-nano",
          "opencode/hy3-preview-free",
          "opencode/minimax-m2.5-free",
          "opencode/nemotron-3-super-free",
          "github-copilot/claude-haiku-4.5",
          "github-copilot/claude-opus-4.5",
          "github-copilot/claude-sonnet-4",
          "github-copilot/claude-sonnet-4.5",
          "github-copilot/claude-sonnet-4.6",
          "github-copilot/gemini-2.5-pro",
          "github-copilot/gemini-3-flash-preview",
          "github-copilot/gemini-3.1-pro-preview",
          "github-copilot/gpt-4.1",
          "github-copilot/gpt-4o",
          "github-copilot/gpt-5-mini",
          "github-copilot/gpt-5.2",
          "github-copilot/gpt-5.2-codex",
          "github-copilot/gpt-5.3-codex",
          "github-copilot/gpt-5.4",
          "github-copilot/gpt-5.4-mini",
          "github-copilot/grok-code-fast-1",
          "openai/gpt-5.2",
          "openai/gpt-5.3-codex",
          "openai/gpt-5.3-codex-spark",
          "openai/gpt-5.4",
          "openai/gpt-5.4-fast",
          "openai/gpt-5.4-mini",
          "openai/gpt-5.4-mini-fast",
          "openai/gpt-5.5",
          "openai/gpt-5.5-fast",
          "openai/gpt-5.5-pro"
        ]
      },
      "default": []
    },
    "excludedAgents": {
      "type": "array",
      "description": "Agent modes that should never trigger automatic compaction.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["plan", "build", "explore"]
      },
      "default": []
    }
  },
  "required": ["excludedModels", "excludedAgents"]
}
